{
  "name": "rampcut",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File test/skyvern/setup.ps1",
    "test:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File test/skyvern/run.ps1",
    "test:ui:headed": "powershell -NoProfile -ExecutionPolicy Bypass -File test/skyvern/run.ps1 -Headed -SlowMo 600",
    "test:ui:export": "powershell -NoProfile -ExecutionPolicy Bypass -File test/skyvern/run_export_test.ps1",
    "test:ui:export:headed": "powershell -NoProfile -ExecutionPolicy Bypass -File test/skyvern/run_export_test.ps1 -Headed"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/node": "^5.8.15",
    "dodopayments": "^1.17.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.17.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.30.0",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vercel": "^59.16.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
