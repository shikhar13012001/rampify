# ── Dodo Payments (Merchant of Record) ───────────────────────────────────────
# Server-side only (never expose to the client)
# Dashboard → Developer → API Keys. Use a test-mode key until cutover is confirmed.
DODO_PAYMENTS_API_KEY=sk_test_...
# Dashboard → Developer → Webhooks → your endpoint → signing secret.
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# "test_mode" while validating; "live_mode" only once you've confirmed the
# cutover with a real (or Dodo's supported test-card / UPI sandbox) payment.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Create both products in Dashboard → Products.
# Monthly recurring: $12/month
DODO_PRO_MONTHLY_PRODUCT_ID=pdt_...
# Annual recurring: $96/year (= $8/month). MUST be "every 1 Year" — an
# earlier product was accidentally "every 1 Month"; `node --env-file=.env.local
# scripts/verify-dodo-products.mjs` now fails loudly on that.
DODO_PRO_ANNUAL_PRODUCT_ID=pdt_...
# Founder Pro: ONE-TIME $59, lifetime Pro, capped at 25 seats (api/_plans.ts).
# Optional — leave unset to hide the founder offer everywhere.
DODO_PRO_FOUNDER_PRODUCT_ID=pdt_...
# Set to 1 ONLY for local `vercel dev` webhook testing. NEVER set in production
# or preview. When unset, the webhook endpoint requires a valid Dodo signature
# and rejects empty bodies.
DODO_WEBHOOK_DEV_BYPASS=0

# ── Allowed redirect origins for Dodo Checkout ───────────────────────────────
# Comma-separated list of production origins that the checkout return URL
# may redirect to. The first entry is used as the fallback when the request
# omits an Origin header. Preview deployments are auto-allowed via VERCEL_URL;
# localhost is allowed automatically for dev.
ALLOWED_ORIGINS=https://rampcut.astralbuild.dev

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Paste the entire service account JSON as a single line (escape quotes as needed).
# Generate at: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_ADMIN_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ── Firebase Client SDK (Vite public env — prefixed VITE_) ───────────────────
# All values from: Firebase Console → Project Settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Google Analytics 4 (optional) ────────────────────────────────────────────
# Analytics → Admin → Data Streams → your web stream → Measurement ID.
# Leave unset to disable — src/lib/googleAnalytics.ts no-ops without it, and
# this app's own first-party funnel analytics (src/lib/analytics.ts) keeps
# working either way; GA is additive, not the source of truth.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
